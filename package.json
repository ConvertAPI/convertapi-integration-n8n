{
	"name": "@convertapi/n8n-nodes-convertapi",
	"version": "0.1.0",
	"description": "n8n node for ConvertAPI: convert files between formats, and merge, compress or OCR PDFs.",
	"license": "MIT",
	"homepage": "https://github.com/ConvertAPI/convertapi-integration-n8n#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"convertapi",
		"pdf",
		"file conversion",
		"docx to pdf",
		"pdf to word",
		"merge pdf",
		"compress pdf",
		"ocr"
	],
	"author": {
		"name": "ConvertAPI",
		"email": "support@convertapi.com",
		"url": "https://www.convertapi.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ConvertAPI/convertapi-integration-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/ConvertAPI/convertapi-integration-n8n/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/unit/*.test.js\"",
		"test:live": "n8n-node build && node --test --test-concurrency=1 \"test/live/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ConvertApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ConvertApi/ConvertApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.1",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
